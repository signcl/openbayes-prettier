{
  "name": "@openbayes/prettier",
  "version": "0.0.5",
  "description": "OpenBayes prettier configuration",
  "main": "index.js",
  "module": "index.mjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs"
  ],
  "scripts": {
    "get-version": "node -p \"require('./package.json').version\"",
    "release:patch": "pnpm version patch && pnpm publish",
    "release:minor": "pnpm version minor && pnpm publish",
    "release:major": "pnpm version major && pnpm publish"
  },
  "homepage": "https://github.com/signcl/openbayes-prettier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signcl/openbayes-prettier.git"
  },
  "keywords": [
    "openbayes",
    "prettier"
  ],
  "author": "lesenelir <hi@lesenelir.me>",
  "license": "MIT",
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "prettier-plugin-packagejson": "^2.5.3",
    "prettier-plugin-sort-json": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808"
}
